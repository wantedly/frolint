{
  "name": "root",
  "private": true,
  "author": "Yuki Yamada <yamada@wantedly.com>",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0 || ^1.0.0",
    "@changesets/cli": "^2.27.1",
    "@types/estree": "^1.0.6",
    "@types/jest": "^27.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lerna": "^4.0.0",
    "lint-staged": "^15.2.10",
    "mock-fs": "^5.0.0",
    "prettier": "^2.8.8",
    "scaffdog": "^1.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "yarn format",
      "yarn lint"
    ],
    "*.json": "yarn format"
  },
  "scripts": {
    "pretest": "yarn build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:update": "jest -u",
    "format": "prettier --write",
    "lint": "eslint --cache",
    "build": "tsc -b packages/eslint-plugin-wantedly",
    "build:watch": "tsc -b packages/eslint-plugin-wantedly --watch",
    "prerelease": "yarn install --force && yarn run build",
    "release": "yarn changeset publish",
    "clean": "rm -rf packages/*/node_modules packages/*/lib packages/*/tsconfig.tsbuildinfo",
    "prepare": "husky"
  },
  "jest": {
    "projects": [
      "<rootDir>/packages/eslint-config-wantedly",
      "<rootDir>/packages/eslint-config-wantedly-typescript",
      "<rootDir>/packages/eslint-plugin-use-macros",
      "<rootDir>/packages/eslint-plugin-wantedly"
    ]
  }
}
